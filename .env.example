# Copia questo file, rinominalo in ".env" e incolla le tue chiavi dopo l'uguale (senza spazi né virgolette).
# Il file .env resta solo sul tuo computer: non condividerlo e non incollarlo in chat.

# OpenAI: serve SOLO per i lavori sulle foto 360 (non per il render 3D da piantina)
# OpenAI: https://platform.openai.com/api-keys  (inizia con sk-proj-...)
OPENAI_API_KEY=

# Anthropic: https://console.anthropic.com/settings/keys  (inizia con sk-ant-api03-...)
ANTHROPIC_API_KEY=

# Spesa massima per progetto, in euro: oltre questa cifra il programma si ferma
SPESA_MASSIMA_EURO=5

# Meshy (modelli 3D dalla foto nel Catalogo): https://www.meshy.ai/settings/api
MESHY_API_KEY=
